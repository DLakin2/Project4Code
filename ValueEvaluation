import numpy as np

state_values=np.zeros((3,3),dtype=float)
print(state_values)
iteration = 0
while True:
    o= state_values.copy()
    state_values[0,0]=0.5*(-1+o[1,0]+1/3*(-10+o[0,0])+2/3*(-1+o[0,1]))
    state_values[0,1]=1/3*(-1+o[0,0]-1+o[0,2]+1/3*(-10+o[0,0])+2/3*(-1+o[1,1]))
    state_values[0,2]=0.5*(-1+o[1,2]+1/3*(-10+o[0,0])+2/3*(-1+o[0,1]))
    state_values[1,0]=1/3*(-1+o[0,0]-1+o[2,0]+1/3*(-10+o[0,0])+2/3*(-1+o[1,1]))
    state_values[1,1]=1/4*(-1+o[1,0]-1+o[1,2]+2/3*(-10+o[0,0])+2/3*(-1+o[0,1])+2/3*(-1+o[2,1]))
    state_values[1,2]=1/3*(-1+o[0,2]+10+1/3*(-10+o[0,0])+2/3*(-1+o[1,1]))
    state_values[2,0]=0.5*(-1+o[1,0]+1/3*(-10+o[0,0])+2/3*(-1+o[2,1]))
    state_values[2,1]=1/3*(-1+o[2,0]+10+1/3*(-10+o[0,0])+2/3*(-1+o[1,1]))
        
    max_delta_value = abs(o - state_values).max()
    if max_delta_value < 1e-4:
        break

    iteration += 1

print(state_values,iteration)
